CONTACT_TO=Thibaut@orbytek.be
CONTACT_FROM=Orbytek <formulaire@notifications.orbytek.be>
RESEND_API_KEY=REPLACE_IN_SUPABASE_SECRETS
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SIGNING_SECRET
TURNSTILE_SECRET_KEY=REPLACE_IN_SUPABASE_SECRETS
CONTACT_HASH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
CONTACT_WORKER_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_SECRET
